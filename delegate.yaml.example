# Animachat Delegate Configuration
# Copy this file to delegate.yaml and fill in your values.

server:
  # WebSocket URL of the Animachat server
  url: ws://localhost:3010
  # Authentication: use EITHER token OR apiKey (not both)
  # Option 1: JWT token (get from browser localStorage after login)
  # token: "your-jwt-token-here"
  # Option 2: Delegate API Key (create in Settings -> API Keys)
  apiKey: "dak_your-api-key-here"

delegate:
  # Unique ID for this delegate instance
  id: "my-dev-machine"
  # Capabilities this delegate supports
  capabilities:
    - mcp_host
    - webhooks

# MCP servers to host locally
# Each server is a subprocess managed by the delegate
mcp_servers:
  # Example: Filesystem access
  - name: filesystem
    command: npx
    args: ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/directory"]

  # Example: GitHub integration
  # - name: github
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-github"]
  #   env:
  #     GITHUB_TOKEN: "${GITHUB_TOKEN}"

  # Example: Brave Search
  # - name: brave-search
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-brave-search"]
  #   env:
  #     BRAVE_API_KEY: "${BRAVE_API_KEY}"

  # Example: Custom MCP server
  # - name: my-custom-tools
  #   command: node
  #   args: ["./my-mcp-server.js"]

# Webhook server for external triggers
webhooks:
  # Set to true to enable the webhook HTTP server
  enabled: false
  # Port for the webhook server
  port: 8080
  # Webhook endpoints
  endpoints:
    # Example: GitLab webhook
    # - source: gitlab
    #   path: /webhooks/gitlab
    #   secret: "${GITLAB_WEBHOOK_SECRET}"
    #   conversation_id: "your-conversation-id"
    #   participant_id: ""  # Empty = first assistant

    # Example: GitHub webhook
    # - source: github
    #   path: /webhooks/github
    #   secret: "${GITHUB_WEBHOOK_SECRET}"
    #   conversation_id: "your-conversation-id"
    #   participant_id: ""
